    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.14.9",
    "hono": "^4.12.14",
    "typescript": "5.9.3"
  },
  "config": {
    "publishOrder": "dependsOnCore"
