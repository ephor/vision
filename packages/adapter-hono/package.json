{
  "name": "@getvision/adapter-hono",
  "version": "0.1.5",
  "description": "Hono adapter for Vision's local API observability and debugging dashboard",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint . --max-warnings 0"
